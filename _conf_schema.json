{
  "base_url": {
    "description": "MCSManager 面板地址",
    "type": "string",
    "hint": "例如 http://localhost:23333，请勿带末尾斜杠",
    "default": "http://localhost:23333"
  },
  "api_token": {
    "description": "MCSManager API 令牌",
    "type": "string",
    "hint": "在面板用户管理中，「API 密钥」中生成或查看",
    "default": ""
  },
  "tool_permissions": {
    "description": "工具权限控制",
    "type": "object",
    "hint": "为每个工具单独设置权限：所有人 = 任何用户可用；仅管理员 = 仅 AstrBot 管理员可用；禁用 = 任何人都不能使用（包括管理员）。「管理员」指 AstrBot 全局配置中的管理员。",
    "items": {
      "mcsmanager_get_overview": {
        "description": "获取面板全局概览",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      },
      "mcsmanager_get_daemon_list": {
        "description": "获取节点列表",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      },
      "mcsmanager_get_instances": {
        "description": "获取实例列表",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      },
      "mcsmanager_get_instance_detail": {
        "description": "获取实例详情",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      },
      "mcsmanager_start_instance": {
        "description": "启动实例",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      },
      "mcsmanager_stop_instance": {
        "description": "停止实例",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      },
      "mcsmanager_restart_instance": {
        "description": "重启实例",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      },
      "mcsmanager_kill_instance": {
        "description": "强制终止实例",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      },
      "mcsmanager_send_command": {
        "description": "发送控制台命令",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      },
      "mcsmanager_get_instance_log": {
        "description": "获取实例日志",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      },
      "mcsmanager_list_files": {
        "description": "列出文件",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      },
      "mcsmanager_read_file": {
        "description": "读取文件",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      },
      "mcsmanager_write_file": {
        "description": "写入文件",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      },
      "mcsmanager_delete_files": {
        "description": "删除文件",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      },
      "mcsmanager_create_folder": {
        "description": "新建文件夹",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      },
      "mcsmanager_compress_files": {
        "description": "压缩文件",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      },
      "mcsmanager_decompress_file": {
        "description": "解压文件",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      },
      "mcsmanager_copy_files": {
        "description": "复制文件",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      },
      "mcsmanager_move_files": {
        "description": "移动或重命名文件",
        "type": "string",
        "options": ["所有人", "仅管理员", "禁用"],
        "default": "仅管理员"
      }
    }
  },
  "blocked_instances": {
    "description": "禁止操作的实例",
    "type": "list",
    "hint": "填写实例 UUID 或名称关键词（子串匹配，忽略大小写），每行一个。被列入的实例对 AI 完全隐藏，且拒绝一切针对它的操作（对管理员同样生效）。",
    "default": []
  }
}
